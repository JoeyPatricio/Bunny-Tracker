# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Build output
client/dist/

# Secrets
.env

# Local working notes
notes/

# Media: recorded clips and rolling capture segments
data/recordings/
data/tmp/
segments/
data/agent/segments/

# Data stores, plus their temp and backup copies
data/labels.json*
data/autolabels.json*
data/labels.meta.json*
data/labels.reliability.json*
data/labels.reliability_sample.json*
data/labels.holdout.json*
data/backups/
data/activity-log.json*
data/monitor.json*
data/hidden.json*

# MobileNet backbone (fetch with scripts/download-mobilenet.mjs)
data/model/mobilenet/

# Python backend (server)
server/.venv/
server/.venv-train/
server/models/cache/
# Archived caches too. `server/models/cache/` above covers only that exact
# path, so moving a cache anywhere else (e.g. archiving it under a versioned
# directory during an ethogram migration) silently makes ~14 MB of embedding
# .npy files trackable again. Match the cache by name at any depth instead.
server/models/**/cache/
# Loose embedding/probability arrays, wherever they land. These are derived
# from the owner's own footage and have no business in a public repo.
server/models/**/*.npy
server/models/**/*.npz
server/agent/live_frame.jpg
__pycache__/
*.pyc

# Raw-bytes copy of the motion fixture, same frames as the .npy next to it.
# Only scripts/js_motion_ground_truth.mjs reads it; scripts/dump_agent_frames.py
# writes both, so regenerate it there rather than carrying 9.6 MB twice.
server/tests/fixtures/motion_fixture_frames.bin

# run.sh process logs
logs/

# Admin session tokens (bearer-equivalent secrets), written by app/auth.py
data/sessions.json*
