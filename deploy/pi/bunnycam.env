# Process environment for bunnycam-server and bunnycam-agent. Both units read
# this file, so the server's SEGMENTS_DIR and the agent's segment writer can
# never disagree. Secrets and camera settings stay in data/.env.
PYTHONUNBUFFERED=1
PYTHONIOENCODING=utf-8
PY_PORT=3001
AGENT_SERVER_URL=http://127.0.0.1:3001
FFMPEG_PATH=/usr/bin/ffmpeg
# tmpfs, created at boot by bunnycam.tmpfiles. Rolling segments and the
# 12-writes-a-second live frame never touch the SD card or SSD.
AGENT_SEGMENT_DIR=/run/bunnycam/segments
AGENT_LIVE_FRAME_PATH=/run/bunnycam/live_frame.jpg
