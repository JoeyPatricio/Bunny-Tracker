[
 {
  "name": "v4l2 alert cadence",
  "camera_format": "v4l2",
  "camera_input": "/dev/video0",
  "camera_size": "1280x720",
  "camera_fps": "30",
  "frame_interval": 1.5,
  "segment_secs": 12,
  "segment_dir": "/run/bunnycam/segments",
  "args": [
   "/usr/bin/ffmpeg",
   "-y",
   "-hide_banner",
   "-loglevel",
   "error",
   "-f",
   "v4l2",
   "-input_format",
   "mjpeg",
   "-video_size",
   "1280x720",
   "-framerate",
   "30",
   "-i",
   "/dev/video0",
   "-vf",
   "fps=0.6667,scale=224:224",
   "-f",
   "rawvideo",
   "-pix_fmt",
   "rgb24",
   "pipe:1",
   "-c:v",
   "libvpx",
   "-deadline",
   "realtime",
   "-cpu-used",
   "8",
   "-threads",
   "1",
   "-b:v",
   "1M",
   "-vf",
   "fps=15,scale=640:360",
   "-r",
   "15",
   "-an",
   "-g",
   "180",
   "-keyint_min",
   "180",
   "-f",
   "segment",
   "-segment_time",
   "12",
   "-reset_timestamps",
   "1",
   "/run/bunnycam/segments/seg-%05d.webm",
   "-vf",
   "fps=12,scale=640:360",
   "-q:v",
   "5",
   "-f",
   "mjpeg",
   "pipe:3"
  ]
 },
